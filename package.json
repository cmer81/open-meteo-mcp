{
  "name": "open-meteo-mcp-server",
  "version": "2.2.0",
  "description": "Model Context Protocol server for Open-Meteo weather APIs",
  "main": "dist/index.js",
  "bin": {
    "open-meteo-mcp-server": "dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "TRANSPORT=http node dist/index.js",
    "dev": "tsx src/index.ts",
    "dev:http": "TRANSPORT=http tsx src/index.ts",
    "docker:build": "docker build -t open-meteo-mcp-server .",
    "docker:run": "docker run -p 3000:3000 open-meteo-mcp-server",
    "test": "vitest",
    "lint": "biome lint src/",
    "format": "biome format --write src/",
    "check": "biome ci src/",
    "typecheck": "tsc --noEmit",
    "eval": "python3 evals/scripts/evaluation.py -t stdio -c node -a dist/index.js evals/evaluation.xml",
    "release": "npm run build && npm run test && npm run lint",
    "release:patch": "npm version patch && git push origin main --tags",
    "release:minor": "npm version minor && git push origin main --tags",
    "release:major": "npm version major && git push origin main --tags",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "open-meteo",
    "weather",
    "weather-api",
    "weather-forecast",
    "meteorology",
    "climate",
    "historical-weather",
    "air-quality",
    "marine-weather",
    "geocoding",
    "ecmwf",
    "llm",
    "claude",
    "ai"
  ],
  "author": "Cedric Mercier",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cmer81/open-meteo-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/cmer81/open-meteo-mcp/issues"
  },
  "homepage": "https://github.com/cmer81/open-meteo-mcp#readme",
  "files": [
    "dist/**/*",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "axios": "^1.20.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.3",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
