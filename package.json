{
  "name": "open-meteo-mcp-server",
  "version": "2.0.2",
  "description": "Model Context Protocol server for Open-Meteo weather APIs",
  "main": "dist/index.js",
  "bin": {
    "open-meteo-mcp-server": "dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "TRANSPORT=http node dist/index.js",
    "dev": "tsx src/index.ts",
    "dev:http": "TRANSPORT=http tsx src/index.ts",
    "docker:build": "docker build -t open-meteo-mcp-server .",
    "docker:run": "docker run -p 3000:3000 open-meteo-mcp-server",
    "test": "vitest",
    "lint": "biome lint src/",
    "format": "biome format --write src/",
    "check": "biome ci src/",
    "typecheck": "tsc --noEmit",
    "eval": "python3 evals/scripts/evaluation.py -t stdio -c node -a dist/index.js evals/evaluation.xml",
    "release": "npm run build && npm run test && npm run lint",
    "release:patch": "npm version patch && git push origin main --tags",
    "release:minor": "npm version minor && git push origin main --tags",
    "release:major": "npm version major && git push origin main --tags",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "keywords": [
    "mcp",
    "weather",
    "open-meteo",
    "forecast",
    "api"
  ],
  "author": "Claude Code",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cmer81/open-meteo-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/cmer81/open-meteo-mcp/issues"
  },
  "homepage": "https://github.com/cmer81/open-meteo-mcp#readme",
  "files": [
    "dist/**/*",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "axios": "^1.20.0",
    "dotenv": "^17.4.2",
    "express": "^4.22.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
